# ---------------------------------------------------------------- Windows

CHAVE_REGISTO_ARRANQUE = r"Software\Microsoft\Windows\CurrentVersion\Run"
NOME_NO_ARRANQUE = "WidgetTempo"


def comando_de_arranque():
    if getattr(sys, "frozen", False):
        return f'"{sys.executable}"'
    pythonw = os.path.join(os.path.dirname(sys.executable), "pythonw.exe")
    if not os.path.exists(pythonw):
        pythonw = sys.executable
    return f'"{pythonw}" "{os.path.abspath(__file__)}"'


def arranque_ativo():
    try:
        import winreg
        with winreg.OpenKey(winreg.HKEY_CURRENT_USER, CHAVE_REGISTO_ARRANQUE) as chave_registo:
            winreg.QueryValueEx(chave_registo, NOME_NO_ARRANQUE)
        return True
    except Exception:
        return False


def definir_arranque(ativar):
    import winreg
    with winreg.OpenKey(winreg.HKEY_CURRENT_USER, CHAVE_REGISTO_ARRANQUE, 0,
                        winreg.KEY_SET_VALUE) as chave_registo:
        if ativar:
            winreg.SetValueEx(chave_registo, NOME_NO_ARRANQUE, 0, winreg.REG_SZ,
                              comando_de_arranque())
        else:
            try:
                winreg.DeleteValue(chave_registo, NOME_NO_ARRANQUE)
            except FileNotFoundError:
                pass


def ja_esta_aberto(segundos_de_espera=0):
    """Evita dois widgets ao mesmo tempo (ex.: atalho de arranque + registo).
    Depois de uma atualização, espera que a versão anterior acabe de fechar."""
    try:
        import ctypes
        import time
        kernel32 = ctypes.windll.kernel32
        limite_espera = time.monotonic() + segundos_de_espera
        while True:
            identificador_mutex = kernel32.CreateMutexW(None, False, "WidgetTempo_unico")
            if kernel32.GetLastError() != 183:  # 183 = ERROR_ALREADY_EXISTS
                ja_esta_aberto.mutex = identificador_mutex
                return False
            kernel32.CloseHandle(identificador_mutex)
            if time.monotonic() >= limite_espera:
                return True
            time.sleep(0.5)
    except Exception:
        return False

# ---------------------------------------------------------------- atualização automática

def registar_atualizacao(mensagem):
    try:
        with open(CAMINHO_REGISTO_ATUALIZACOES, "a", encoding="utf-8") as registo:
            registo.write(f"{datetime.datetime.now():%d/%m/%Y %H:%M:%S}  {mensagem}\n")
    except Exception:
        pass


def versao_como_numeros(texto_versao):
    return tuple(int(parte) for parte in str(texto_versao).split("."))


def procurar_e_instalar_atualizacao(url_base=None):
    """Se houver versão mais recente publicada, descarrega-a, valida-a e substitui
    este ficheiro (guardando o anterior). Devolve True se instalou uma versão nova.
    Nunca substitui nada se alguma verificação falhar."""
    import hashlib
    if getattr(sys, "frozen", False):
        return False  # o .exe não se atualiza a si próprio; usar o .pyw
    url_base = url_base or URL_ATUALIZACOES
    marca_tempo = int(datetime.datetime.now().timestamp())
    try:
        manifesto = pedir_json(f"{url_base}versao.json?t={marca_tempo}")
        versao_publicada = str(manifesto["versao"])
        if versao_como_numeros(versao_publicada) <= versao_como_numeros(VERSAO_PROGRAMA):
            return False
        pedido = urllib.request.Request(
            f"{url_base}{manifesto['ficheiro']}?t={marca_tempo}",
            headers={"User-Agent": "WidgetTempo/1.0"})
        with urllib.request.urlopen(pedido, timeout=60) as resposta:
            conteudo_novo = resposta.read()
        # 1) ficheiro completo e igual ao publicado
        if len(conteudo_novo) != int(manifesto["tamanho"]):
            raise ValueError(f"tamanho errado ({len(conteudo_novo)} em vez de {manifesto['tamanho']})")
        if hashlib.sha256(conteudo_novo).hexdigest() != manifesto["sha256"]:
            raise ValueError("assinatura SHA-256 não confere")
        # 2) código Python válido e com a versão anunciada
        codigo_novo = conteudo_novo.decode("utf-8")
        compile(codigo_novo, "widget_tempo.pyw", "exec")
        if f'VERSAO_PROGRAMA = "{versao_publicada}"' not in codigo_novo:
            raise ValueError("a versão dentro do ficheiro não corresponde ao anúncio")
        # 3) substituir com segurança: cópia da versão atual + troca atómica
        caminho_atual = os.path.abspath(__file__)
        caminho_temporario = caminho_atual + ".novo"
        caminho_anterior = os.path.join(os.path.dirname(caminho_atual), "widget_tempo_anterior.pyw")
        with open(caminho_temporario, "wb") as ficheiro_temporario:
            ficheiro_temporario.write(conteudo_novo)
        import shutil
        shutil.copy2(caminho_atual, caminho_anterior)
        os.replace(caminho_temporario, caminho_atual)
        registar_atualizacao(f"atualizado de {VERSAO_PROGRAMA} para {versao_publicada}")
        return True
    except Exception as erro:
        registar_atualizacao(f"verificação falhou (fica a versão {VERSAO_PROGRAMA}): {erro}")
        return False


def reiniciar_widget():
    """Arranca a versão nova (que espera que esta feche) e termina esta."""
    import subprocess
    executavel = sys.executable
    pythonw = os.path.join(os.path.dirname(executavel), "pythonw.exe")
    if os.path.exists(pythonw):
        executavel = pythonw
    subprocess.Popen([executavel, os.path.abspath(__file__), "--apos-atualizacao"],
                     cwd=os.path.dirname(os.path.abspath(__file__)))

# ---------------------------------------------------------------- interface

def executar_widget():
    import tkinter as tk

    if ja_esta_aberto(segundos_de_espera=15 if "--apos-atualizacao" in sys.argv else 0):
        return

    try:  # texto nítido em ecrãs com escala (Windows)
        import ctypes
        ctypes.windll.shcore.SetProcessDpiAwareness(1)
    except Exception:
        pass

    COR_FUNDO, COR_FUNDO_HOJE = "#1e2229", "#2a3039"
    COR_FUNDO_SECAGEM = "#4a4220"  # amarelado: melhor dia para secar roupa
    COR_TEXTO, COR_TEXTO_APAGADO = "#e8eaed", "#8b93a1"
    COR_LARANJA, COR_AZUL, COR_VERMELHO = "#f2a33a", "#5cc8ff", "#ff7b72"
    TIPO_LETRA = "Segoe UI"

    config = ler_config()
    cache = ler_cache()
    resultados_dos_pedidos = queue.Queue()

    janela = tk.Tk()
    janela.title("Previsão do tempo")
    janela.overrideredirect(True)
    janela.configure(bg=COR_FUNDO)
    janela.attributes("-alpha", 0.93)
    janela.attributes("-topmost", bool(config["sempre_visivel"]))

    escala_ecra = janela.winfo_fpixels("1i") / 96.0
    tamanhos_icone = sorted(next(iter(ICONES_PNG.values())).keys())
    tamanho_icone = next((t for t in tamanhos_icone if t >= 44 * escala_ecra * 0.97),
                         tamanhos_icone[-1])
    imagens_icone = {nome: tk.PhotoImage(data=png_por_tamanho[tamanho_icone])
                     for nome, png_por_tamanho in ICONES_PNG.items()}
    imagens_algarismo = {caracter: tk.PhotoImage(data=png)
                         for caracter, png in GLIFOS_PNG[tamanho_icone].items()}
    tamanho_icone_pequeno = next((t for t in tamanhos_icone if t >= 30 * escala_ecra * 0.97),
                                 tamanhos_icone[-1])
    imagens_icone_pequeno = {nome: tk.PhotoImage(data=png_por_tamanho[tamanho_icone_pequeno])
                             for nome, png_por_tamanho in ICONES_PNG.items()}

    def sobrepor_temperatura(tela_icone, temperatura):
        """Escreve a temperatura no centro do ícone com algarismos translúcidos."""
        imagens = [imagens_algarismo[c] for c in f"{round(temperatura)}°" if c in imagens_algarismo]
        margem_transparente = 6
        largura_total = sum(i.width() for i in imagens) - margem_transparente * (len(imagens) - 1)
        posicao_x = (tamanho_icone - largura_total) / 2
        for imagem in imagens:
            tela_icone.create_image(posicao_x, tamanho_icone * 0.56, image=imagem, anchor="w")
            posicao_x += imagem.width() - margem_transparente

    corpo = tk.Frame(janela, bg=COR_FUNDO, padx=12, pady=8)
    corpo.pack()

    # --- arrastar e clicar
    arrasto = {"desvio_x": 0, "desvio_y": 0, "inicio_x": -99, "inicio_y": -99}

    def iniciar_arrasto(evento):
        arrasto["desvio_x"] = evento.x_root - janela.winfo_x()
        arrasto["desvio_y"] = evento.y_root - janela.winfo_y()
        arrasto["inicio_x"], arrasto["inicio_y"] = evento.x_root, evento.y_root

    def arrastar(evento):
        janela.geometry(f"+{evento.x_root - arrasto['desvio_x']}+{evento.y_root - arrasto['desvio_y']}")

    def terminar_arrasto(evento):
        foi_clique = (abs(evento.x_root - arrasto["inicio_x"]) <= 3
                      and abs(evento.y_root - arrasto["inicio_y"]) <= 3)
        if foi_clique:
            if estado_vista["em_animacao"]:
                return
            if estado_vista["dia_em_detalhe"] is not None:
                deslizar_para(None)  # no detalhe, qualquer clique volta aos 5 dias
            else:
                indice_dia = getattr(evento.widget, "indice_dia", None)
                if indice_dia is not None:
                    deslizar_para(indice_dia)
            return
        config["posicao"] = [janela.winfo_x(), janela.winfo_y()]
        gravar_json(CAMINHO_CONFIG, config)

    # --- menu do botão direito
    opcao_sempre_visivel = tk.BooleanVar(value=bool(config["sempre_visivel"]))

    def alternar_sempre_visivel():
        config["sempre_visivel"] = opcao_sempre_visivel.get()
        janela.attributes("-topmost", opcao_sempre_visivel.get())
        gravar_json(CAMINHO_CONFIG, config)

    menu = tk.Menu(janela, tearoff=0)
    menu.add_command(label="Atualizar agora", command=lambda: pedir_atualizacao(manual=True))
    menu.add_checkbutton(label="Sempre visível", variable=opcao_sempre_visivel,
                         command=alternar_sempre_visivel)
    if sys.platform == "win32":
        opcao_arranque = tk.BooleanVar(value=arranque_ativo())

        def alternar_arranque():
            try:
                definir_arranque(opcao_arranque.get())
            except Exception:
                opcao_arranque.set(arranque_ativo())

        menu.add_checkbutton(label="Iniciar com o Windows", variable=opcao_arranque,
                             command=alternar_arranque)
    menu.add_separator()
    menu.add_command(label="Sair", command=janela.destroy)

    def ligar_rato(janela_principal):
        # ligações só na janela principal: valem para todos os elementos dentro dela
        # (ligar também cada elemento faria cada clique contar duas vezes)
        janela_principal.bind("<ButtonPress-1>", iniciar_arrasto)
        janela_principal.bind("<B1-Motion>", arrastar)
        janela_principal.bind("<ButtonRelease-1>", terminar_arrasto)
        janela_principal.bind("<Button-3>", lambda evento: menu.tk_popup(evento.x_root, evento.y_root))

    # --- dica ao passar o rato
    dica_aberta = {"janela": None}

    def mostrar_dica(evento, texto):
        esconder_dica()
        janela_dica = tk.Toplevel(janela)
        janela_dica.overrideredirect(True)
        janela_dica.attributes("-topmost", True)
        tk.Label(janela_dica, text=texto, bg="#3a414c", fg=COR_TEXTO, font=(TIPO_LETRA, 9),
                 padx=6, pady=2).pack()
        janela_dica.update_idletasks()
        posicao_x = evento.x_root + 12
        limite_direito = janela.winfo_x() + janela.winfo_width()
        if posicao_x + janela_dica.winfo_reqwidth() > limite_direito:
            # não passar da margem direita do widget (que costuma estar encostado ao ecrã)
            posicao_x = max(janela.winfo_x(), limite_direito - janela_dica.winfo_reqwidth())
        janela_dica.geometry(f"+{posicao_x}+{evento.y_root + 18}")
        dica_aberta["janela"] = janela_dica

    def esconder_dica(_evento=None):
        if dica_aberta["janela"] is not None:
            dica_aberta["janela"].destroy()
            dica_aberta["janela"] = None

    def cor_do_vento(nos):
        if nos is None:
            return COR_TEXTO_APAGADO
        if nos >= 22:
            return COR_VERMELHO
        if nos >= 15:
            return COR_LARANJA
        return COR_AZUL

    # --- vistas: grelha dos 5 dias e detalhe de 4 em 4 horas (entra pela direita)
    estado_vista = {
        "dia_em_detalhe": None,   # índice do dia aberto em detalhe; None = grelha dos 5 dias
        "em_animacao": False,
        "molduras": [],           # [grelha dos 5 dias, detalhe do dia 0, detalhe do dia 1, ...]
        "dias": [],
        "titulo": None,
        "largura_area": 0,
    }

    def construir_detalhe(area_vistas, dia):
        moldura = tk.Frame(area_vistas, bg=COR_FUNDO)
        blocos_4h = dia.get("blocos_4h") or []
        if not blocos_4h:
            tk.Label(moldura, text="Detalhe disponível após a próxima atualização…",
                     bg=COR_FUNDO, fg=COR_TEXTO_APAGADO, font=(TIPO_LETRA, 9)
                     ).grid(row=0, column=0, pady=24)
            return moldura
        for linha, etiqueta in enumerate(["", "", "°C", "Vento (raj.)", "Chuva", "mm"]):
            tk.Label(moldura, text=etiqueta, bg=COR_FUNDO, fg=COR_TEXTO_APAGADO,
                     font=(TIPO_LETRA, 8), anchor="e"
                     ).grid(row=linha, column=0, sticky="e", padx=(0, 6))
        hora_atual = datetime.datetime.now().hour
        for coluna, bloco in enumerate(blocos_4h, start=1):
            bloco_ja_passou = (dia["nome_dia"] == "Hoje"
                               and int(bloco["hora"][:2]) + 4 <= hora_atual)
            cor_principal = COR_TEXTO_APAGADO if bloco_ja_passou else COR_TEXTO
            cor_forcada = COR_TEXTO_APAGADO if bloco_ja_passou else None

            def colocar(linha, elemento):
                elemento.grid(row=linha, column=coluna, sticky="nsew", ipadx=3)

            colocar(0, tk.Label(moldura, text=bloco["hora"], bg=COR_FUNDO, fg=cor_principal,
                                font=(TIPO_LETRA, 9, "bold"), pady=3))
            icone = tk.Label(moldura, bg=COR_FUNDO,
                             image=imagens_icone_pequeno.get(bloco["icone"],
                                                             imagens_icone_pequeno["nublado"]))
            icone.bind("<Enter>", lambda evento, texto=bloco["descricao"]: mostrar_dica(evento, texto))
            icone.bind("<Leave>", esconder_dica)
            colocar(1, icone)
            colocar(2, tk.Label(moldura, text=formatar_numero(bloco["temperatura"], "°"),
                                bg=COR_FUNDO, fg=cor_principal, font=(TIPO_LETRA, 10, "bold")))
            celula_vento = tk.Frame(moldura, bg=COR_FUNDO)
            conjunto_vento = tk.Frame(celula_vento, bg=COR_FUNDO)
            conjunto_vento.pack()
            tk.Label(conjunto_vento, text=formatar_numero(bloco["vento_nos"]), bg=COR_FUNDO,
                     fg=cor_forcada or cor_do_vento(bloco["vento_nos"]),
                     font=(TIPO_LETRA, 10, "bold")).pack(side="left")
            tk.Label(conjunto_vento, text=f"({formatar_numero(bloco['rajada_nos'])})", bg=COR_FUNDO,
                     fg=cor_forcada or cor_do_vento(bloco["rajada_nos"]),
                     font=(TIPO_LETRA, 9)).pack(side="left", padx=(2, 0))
            colocar(3, celula_vento)
            colocar(4, tk.Label(moldura, text=formatar_numero(bloco["prob_chuva"], "%"),
                                bg=COR_FUNDO, fg=cor_forcada or COR_AZUL, font=(TIPO_LETRA, 9)))
            chuva_mm = bloco.get("chuva_mm") or 0
            texto_mm = f"{chuva_mm:.1f}".replace(".", ",") if chuva_mm >= 0.1 else "—"
            cor_mm = cor_forcada or (COR_AZUL if chuva_mm >= 0.1 else COR_TEXTO_APAGADO)
            colocar(5, tk.Label(moldura, text=texto_mm, bg=COR_FUNDO, fg=cor_mm,
                                font=(TIPO_LETRA, 9)))
        return moldura

    def atualizar_titulo():
        titulo = estado_vista["titulo"]
        if titulo is None:
            return
        if estado_vista["dia_em_detalhe"] is None:
            titulo.config(text=f"📍 {config['nome_local']} — próximos 5 dias", cursor="")
        else:
            dia = estado_vista["dias"][estado_vista["dia_em_detalhe"]]
            titulo.config(text=f"‹  {dia['nome_dia']} — de 4 em 4 horas", cursor="hand2")

    def deslizar_para(indice_dia):
        """indice_dia = dia a mostrar em detalhe; None = voltar à grelha dos 5 dias."""
        if estado_vista["em_animacao"] or not estado_vista["molduras"]:
            return
        largura = estado_vista["largura_area"]
        molduras = estado_vista["molduras"]
        if indice_dia is not None:
            moldura_que_sai, moldura_que_entra, sentido = molduras[0], molduras[indice_dia + 1], -1
            if not estado_vista["dias"][indice_dia].get("blocos_4h"):
                pedir_atualizacao(manual=True)
        else:
            moldura_que_sai = molduras[estado_vista["dia_em_detalhe"] + 1]
            moldura_que_entra, sentido = molduras[0], 1
        estado_vista["dia_em_detalhe"] = indice_dia
        atualizar_titulo()
        esconder_dica()
        moldura_que_entra.place(x=moldura_que_entra.posicao_x - sentido * largura, y=0)
        estado_vista["em_animacao"] = True
        total_passos = 14

        def passo_da_animacao(numero_passo):
            progresso = 1 - (1 - numero_passo / total_passos) ** 3  # abranda no fim
            moldura_que_sai.place(x=moldura_que_sai.posicao_x + sentido * largura * progresso, y=0)
            moldura_que_entra.place(
                x=moldura_que_entra.posicao_x - sentido * largura * (1 - progresso), y=0)
            if numero_passo < total_passos:
                janela.after(15, lambda: passo_da_animacao(numero_passo + 1))
            else:
                moldura_que_sai.place_forget()
                estado_vista["em_animacao"] = False
        passo_da_animacao(1)

    # --- desenhar tudo
    ETIQUETAS_LINHAS_GRELHA = ["", "", "°C", "Vento (raj.)", "Chuva"]

    def desenhar():
        esconder_dica()
        for elemento in corpo.winfo_children():
            elemento.destroy()
        estado_vista["em_animacao"] = False

        estado_vista["titulo"] = tk.Label(corpo, text="", bg=COR_FUNDO, fg=COR_TEXTO,
                                          font=(TIPO_LETRA, 10, "bold"), anchor="w")
        estado_vista["titulo"].pack(fill="x", pady=(0, 4))

        dias_accuweather = dias_da_cache(cache, "accuweather")
        dias_open_meteo = dias_da_cache(cache, "open_meteo")
        dias = juntar_fontes(dias_accuweather, dias_open_meteo)
        estado_vista["dias"] = dias
        if estado_vista["dia_em_detalhe"] is not None and estado_vista["dia_em_detalhe"] >= len(dias):
            estado_vista["dia_em_detalhe"] = None

        observacao = (cache.get("observacao_aeroporto") or {}).get("medicao") or {}
        observacao_recente = bool(
            observacao.get("temperatura") is not None and observacao.get("medido_em")
            and datetime.datetime.now() - datetime.datetime.fromtimestamp(observacao["medido_em"])
            < datetime.timedelta(hours=2))

        area_vistas = tk.Frame(corpo, bg=COR_FUNDO)  # área onde as vistas deslizam
        area_vistas.pack()
        grelha = tk.Frame(area_vistas, bg=COR_FUNDO)

        if not dias:
            tk.Label(grelha, text="Sem dados ainda — a obter previsão…", bg=COR_FUNDO,
                     fg=COR_TEXTO_APAGADO, font=(TIPO_LETRA, 9)).grid(row=0, column=0)
        else:
            for linha, etiqueta in enumerate(ETIQUETAS_LINHAS_GRELHA):
                tk.Label(grelha, text=etiqueta, bg=COR_FUNDO, fg=COR_TEXTO_APAGADO,
                         font=(TIPO_LETRA, 8), anchor="e"
                         ).grid(row=linha, column=0, sticky="e", padx=(0, 6))

            indice_dia_secagem = indice_melhor_dia_secagem(dias)
            for coluna, dia in enumerate(dias, start=1):
                if coluna - 1 == indice_dia_secagem:
                    cor_fundo_coluna = COR_FUNDO_SECAGEM
                elif dia["nome_dia"] == "Hoje":
                    cor_fundo_coluna = COR_FUNDO_HOJE
                else:
                    cor_fundo_coluna = COR_FUNDO

                def colocar(linha, elemento):
                    elemento.grid(row=linha, column=coluna, sticky="nsew", ipadx=4)

                etiqueta_dia = tk.Label(grelha, text=dia["nome_dia"], bg=cor_fundo_coluna,
                                        fg=COR_TEXTO, font=(TIPO_LETRA, 9, "bold"), pady=3,
                                        cursor="hand2")
                etiqueta_dia.indice_dia = coluna - 1
                colocar(0, etiqueta_dia)

                imagem = imagens_icone.get(dia["icone"], imagens_icone["nublado"])
                texto_dica = dia["descricao"]
                if coluna - 1 == indice_dia_secagem:
                    periodo = dia["secagem"]
                    potencial_texto = f"{periodo['potencial_mm']:.1f}".replace(".", ",")
                    texto_dica += (f"\n👕 Melhor dia para secar roupa: das {periodo['hora_inicio']}h "
                                   f"às {periodo['hora_fim']}h (potencial {potencial_texto} mm)")
                if dia["nome_dia"] == "Hoje" and observacao_recente:
                    # ícone de hoje com a temperatura medida sobreposta (algarismos translúcidos)
                    icone = tk.Canvas(grelha, width=tamanho_icone, height=tamanho_icone,
                                      bg=cor_fundo_coluna, highlightthickness=0)
                    icone.create_image(tamanho_icone // 2, tamanho_icone // 2, image=imagem)
                    sobrepor_temperatura(icone, observacao["temperatura"])
                    hora_medicao = datetime.datetime.fromtimestamp(observacao["medido_em"])
                    texto_dica += (
                        f"\nAgora: {formatar_numero(observacao['temperatura'])}° medidos às "
                        f"{hora_medicao:%H:%M} no aeroporto"
                        f"\nVento {observacao['direcao']} {formatar_numero(observacao.get('vento_nos'))}"
                        + (f" ({formatar_numero(observacao['rajada_nos'])})"
                           if observacao.get("rajada_nos") else "")
                        + " kn")
                else:
                    icone = tk.Label(grelha, image=imagem, bg=cor_fundo_coluna, pady=2)
                icone.configure(cursor="hand2")
                icone.indice_dia = coluna - 1
                icone.bind("<Enter>", lambda evento, texto=texto_dica + "\n(clique para detalhe)":
                           mostrar_dica(evento, texto))
                icone.bind("<Leave>", esconder_dica)
                colocar(1, icone)

                celula_temperaturas = tk.Frame(grelha, bg=cor_fundo_coluna)
                conjunto_temperaturas = tk.Frame(celula_temperaturas, bg=cor_fundo_coluna)
                conjunto_temperaturas.pack()
                tk.Label(conjunto_temperaturas, text=f"{formatar_numero(dia['temp_max'])}°",
                         bg=cor_fundo_coluna, fg=COR_TEXTO,
                         font=(TIPO_LETRA, 10, "bold")).pack(side="left")
                tk.Label(conjunto_temperaturas, text=f"{formatar_numero(dia['temp_min'])}°",
                         bg=cor_fundo_coluna, fg=COR_TEXTO_APAGADO,
                         font=(TIPO_LETRA, 9)).pack(side="left", padx=(3, 0))
                colocar(2, celula_temperaturas)

                celula_vento = tk.Frame(grelha, bg=cor_fundo_coluna)
                conjunto_vento = tk.Frame(celula_vento, bg=cor_fundo_coluna)
                conjunto_vento.pack()
                # conjunto "vento (rajada)" centrado na coluna, como as temperaturas e a chuva
                tk.Label(conjunto_vento, text=formatar_numero(dia["vento_nos"]),
                         bg=cor_fundo_coluna, fg=cor_do_vento(dia["vento_nos"]),
                         font=(TIPO_LETRA, 10, "bold")).pack(side="left")
                tk.Label(conjunto_vento, text=f"({formatar_numero(dia['rajada_nos'])})",
                         bg=cor_fundo_coluna, fg=cor_do_vento(dia["rajada_nos"]),
                         font=(TIPO_LETRA, 9)).pack(side="left", padx=(2, 0))
                colocar(3, celula_vento)

                colocar(4, tk.Label(grelha, text=formatar_numero(dia["prob_chuva"], "%"),
                                    bg=cor_fundo_coluna, fg=COR_AZUL, font=(TIPO_LETRA, 9)))

        # tamanho fixo da área = maior das vistas (não salta ao mudar de vista)
        estado_vista["molduras"] = [grelha] + [construir_detalhe(area_vistas, dia) for dia in dias]
        janela.update_idletasks()
        largura_area = max(m.winfo_reqwidth() for m in estado_vista["molduras"])
        altura_area = max(m.winfo_reqheight() for m in estado_vista["molduras"])
        estado_vista["largura_area"] = largura_area
        area_vistas.configure(width=largura_area, height=altura_area)
        for moldura in estado_vista["molduras"]:
            moldura.posicao_x = (largura_area - moldura.winfo_reqwidth()) // 2
        dia_em_detalhe = estado_vista["dia_em_detalhe"]
        moldura_visivel = estado_vista["molduras"][0 if dia_em_detalhe is None else dia_em_detalhe + 1]
        moldura_visivel.place(x=moldura_visivel.posicao_x, y=0)
        atualizar_titulo()

        # sem rodapé visível: hora da última atualização e fontes aparecem ao passar o
        # rato sobre o título
        modelo = config["modelo_vento"].split("_")[0].upper()
        fontes = (("AccuWeather · " if dias_accuweather else "") + f"Open-Meteo {modelo}"
                  + (f" · {config['estacao_metar']}" if observacao else ""))
        texto_info = (f"Atualizado {cache.get('atualizado_em', '—')}\nDados: {fontes}"
                      f"\nVersão {VERSAO_PROGRAMA}")
        estado_vista["titulo"].bind("<Enter>", lambda evento: mostrar_dica(evento, texto_info))
        estado_vista["titulo"].bind("<Leave>", esconder_dica)
        ligar_rato(janela)

    # --- pedidos às fontes (em segundo plano, para a janela não congelar)
    def pedir_previsoes():
        resultado = {"atualizado_em": datetime.datetime.now().strftime("%d/%m %H:%M")}
        for fonte_previsao, funcao_obter in (("accuweather", obter_accuweather),
                                             ("open_meteo", obter_open_meteo)):
            try:
                resultado[fonte_previsao] = {"dias": funcao_obter(config)}
            except Exception as erro:
                if isinstance(erro, urllib.error.HTTPError):
                    mensagem_erro = f"erro HTTP {erro.code}"
                elif isinstance(erro, urllib.error.URLError):
                    mensagem_erro = "sem ligação à internet"
                else:
                    mensagem_erro = str(erro)
                # mantém os últimos dias recebidos dessa fonte
                resultado[fonte_previsao] = {"dias": dias_da_cache(cache, fonte_previsao),
                                             "erro": mensagem_erro}
        resultados_dos_pedidos.put(resultado)

    def pedir_observacao():
        try:
            resultados_dos_pedidos.put({"observacao_aeroporto": {"medicao": obter_metar(config)}})
        except Exception:
            pass  # sem medição: mantém-se a última

    def verificar_resultados():
        try:
            resultado = resultados_dos_pedidos.get_nowait()
            if resultado.get("atualizacao_instalada"):
                reiniciar_widget()
                janela.destroy()
                return
            if (resultado.get("open_meteo") or {}).get("erro"):
                # falhou (ex.: rede ainda não ligada no arranque): tenta de novo em 2 min
                janela.after(2 * 60 * 1000, lambda: pedir_atualizacao(manual=True))
            cache.update(resultado)
            cache["versao"] = VERSAO_CACHE
            gravar_json(CAMINHO_CACHE, cache)
            desenhar()
        except queue.Empty:
            pass
        janela.after(500, verificar_resultados)

    def pedir_atualizacao(manual=False):
        threading.Thread(target=pedir_previsoes, daemon=True).start()
        threading.Thread(target=pedir_observacao, daemon=True).start()
        if not manual:
            janela.after(int(config["intervalo_minutos"]) * 60 * 1000, pedir_atualizacao)

    def verificar_atualizacao_periodica():
        def em_segundo_plano():
            if procurar_e_instalar_atualizacao():
                resultados_dos_pedidos.put({"atualizacao_instalada": True})
        threading.Thread(target=em_segundo_plano, daemon=True).start()
        janela.after(INTERVALO_VERIFICACAO_ATUALIZACAO_HORAS * 3600 * 1000,
                     verificar_atualizacao_periodica)

    def pedir_observacao_periodica():  # o aeroporto publica de 30 em 30 min
        threading.Thread(target=pedir_observacao, daemon=True).start()
        janela.after(15 * 60 * 1000, pedir_observacao_periodica)

    # --- posição inicial: a guardada, se ainda estiver dentro do(s) ecrã(s)
    desenhar()
    janela.update_idletasks()
    largura_janela, altura_janela = janela.winfo_reqwidth(), janela.winfo_reqheight()
    try:  # área de todos os monitores (Windows)
        import ctypes
        medida_sistema = ctypes.windll.user32.GetSystemMetrics
        ecra_x, ecra_y = medida_sistema(76), medida_sistema(77)
        ecra_largura, ecra_altura = medida_sistema(78), medida_sistema(79)
    except Exception:
        ecra_x, ecra_y = 0, 0
        ecra_largura, ecra_altura = janela.winfo_screenwidth(), janela.winfo_screenheight()
    posicao_x, posicao_y = ecra_x + ecra_largura - largura_janela - 30, ecra_y + 40
    posicao_guardada = config.get("posicao")
    if isinstance(posicao_guardada, (list, tuple)) and len(posicao_guardada) == 2:
        guardada_x, guardada_y = posicao_guardada
        widget_fica_visivel = (
            ecra_x - largura_janela / 2 <= guardada_x <= ecra_x + ecra_largura - largura_janela / 2
            and ecra_y - 10 <= guardada_y <= ecra_y + ecra_altura - altura_janela / 2)
        if widget_fica_visivel:
            posicao_x, posicao_y = guardada_x, guardada_y
    janela.geometry(f"+{int(posicao_x)}+{int(posicao_y)}")

    pedir_atualizacao()
    janela.after(15 * 60 * 1000, pedir_observacao_periodica)
    janela.after(30 * 1000, verificar_atualizacao_periodica)  # 30 s após arrancar
    verificar_resultados()
    janela.mainloop()


