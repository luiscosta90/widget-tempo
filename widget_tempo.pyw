# ---------------------------------------------------------------- utilitários

def ler_json(caminho, valor_se_falhar):
    try:
        with open(caminho, "r", encoding="utf-8") as ficheiro:
            return json.load(ficheiro)
    except Exception:
        return valor_se_falhar


def gravar_json(caminho, conteudo):
    with open(caminho, "w", encoding="utf-8") as ficheiro:
        json.dump(conteudo, ficheiro, ensure_ascii=False, indent=2)


def ler_config():
    config = dict(CONFIG_POR_OMISSAO)
    config_guardada = ler_json(CAMINHO_CONFIG, {})
    if isinstance(config_guardada, dict):
        config.update(config_guardada)
    return config


def ler_cache():
    """Lê o cache.json; se for de outra versão ou estiver estragado, começa vazio."""
    cache_guardada = ler_json(CAMINHO_CACHE, {})
    if not isinstance(cache_guardada, dict) or cache_guardada.get("versao") != VERSAO_CACHE:
        return {"versao": VERSAO_CACHE}
    return cache_guardada


def dias_da_cache(cache, fonte_previsao):
    """Lista de dias guardada para uma fonte ('accuweather' ou 'open_meteo'); [] se não houver."""
    seccao_da_fonte = cache.get(fonte_previsao)
    if not isinstance(seccao_da_fonte, dict):
        return []
    dias_previstos = seccao_da_fonte.get("dias")
    return dias_previstos if isinstance(dias_previstos, list) else []


def pedir_json(url, cabecalhos_extra=None):
    cabecalhos = {"User-Agent": "WidgetTempo/1.0"}
    cabecalhos.update(cabecalhos_extra or {})
    pedido = urllib.request.Request(url, headers=cabecalhos)
    with urllib.request.urlopen(pedido, timeout=20) as resposta:
        return json.loads(resposta.read().decode("utf-8"))


NOMES_DIAS_SEMANA = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"]


def nome_do_dia(data_iso):
    data = datetime.date.fromisoformat(data_iso[:10])
    if data == datetime.date.today():
        return "Hoje"
    return f"{NOMES_DIAS_SEMANA[data.weekday()]} {data.day:02d}"


RUMOS = ["N", "NE", "E", "SE", "S", "SO", "O", "NO"]


def rumo_do_vento(direcao_graus):
    if direcao_graus is None:
        return "—"
    return RUMOS[int((direcao_graus % 360) / 45 + 0.5) % 8]


def formatar_numero(valor, sufixo=""):
    if valor is None:
        return "—"
    return f"{round(valor)}{sufixo}"

