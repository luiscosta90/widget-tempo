}


def icone_accuweather(numero_icone):
    """Converte o número de ícone do AccuWeather (1–44) numa categoria."""
    if numero_icone in (1, 2, 30, 31, 32, 33, 34):
        return "sol"
    if numero_icone in (3, 4, 5, 35, 36, 37):
        return "parcial"
    if numero_icone == 11:
        return "nevoeiro"
    if numero_icone in (12, 13, 14, 39, 40):
        return "aguaceiros"
    if numero_icone in (18, 26, 29):
        return "chuva"
    if numero_icone in (15, 16, 17, 41, 42):
        return "trovoada"
    if numero_icone in (19, 20, 21, 22, 23, 24, 25, 43, 44):
        return "neve"
    return "nublado"

# ---------------------------------------------------------------- Open-Meteo

HORAS_INICIO_BLOCOS = (0, 4, 8, 12, 16, 20)
ICONE_DE_NOITE = {"sol": "lua", "parcial": "lua_parcial", "aguaceiros": "chuva"}


def blocos_4h_por_dia(resposta_open_meteo):
    """Detalhe de cada dia em blocos de 4 h: ícone e temperatura no início do bloco,
    vento/rajada/probabilidade máximos do bloco e chuva total (mm)."""
    previsao_horaria = resposta_open_meteo.get("hourly") or {}
    instantes = previsao_horaria.get("time") or []

    def valor_horario(variavel, posicao):
        valores = previsao_horaria.get(variavel) or []
        return valores[posicao] if posicao < len(valores) else None

    blocos_por_data = {}
    for posicao_inicio, instante in enumerate(instantes):
        hora = int(instante[11:13])
        if hora not in HORAS_INICIO_BLOCOS:
            continue
        posicoes_do_bloco = range(posicao_inicio, min(posicao_inicio + 4, len(instantes)))

        def maximo_no_bloco(variavel):
            valores = [valor_horario(variavel, p) for p in posicoes_do_bloco]
            return max((v for v in valores if v is not None), default=None)

        chuva_mm = sum(v for v in (valor_horario("precipitation", p) for p in posicoes_do_bloco)
                       if v is not None)
        descricao, icone = CODIGOS_WMO.get(valor_horario("weather_code", posicao_inicio),
                                           ("—", "nublado"))
        if valor_horario("is_day", posicao_inicio) == 0:
            icone = ICONE_DE_NOITE.get(icone, icone)
        blocos_por_data.setdefault(instante[:10], []).append({
            "hora": f"{hora:02d}h",
            "icone": icone,
            "descricao": descricao,
            "temperatura": valor_horario("temperature_2m", posicao_inicio),
            "vento_nos": maximo_no_bloco("wind_speed_10m"),
            "rajada_nos": maximo_no_bloco("wind_gusts_10m"),
            "prob_chuva": maximo_no_bloco("precipitation_probability"),
            "chuva_mm": round(chuva_mm, 1),
        })
    return blocos_por_data


# Melhor dia para secar roupa na rua.
# Uma hora conta como "seca" se for de dia, sem chuva prevista (< 0,1 mm), com probabilidade
# de chuva até 20% e humidade < 90%. O potencial de secagem de um período é a soma da
# evapotranspiração de referência (ET0, FAO-56 Penman-Monteith: sol, temperatura, humidade
# e vento) dessas horas, em mm. Um dia é bom se tiver pelo menos 4 horas secas seguidas
# com potencial >= 0,5 mm.
SECAGEM_PROB_CHUVA_MAXIMA = 20      # %
SECAGEM_CHUVA_MAXIMA_MM = 0.1       # mm por hora
SECAGEM_HUMIDADE_MAXIMA = 90        # % (exclusive)
SECAGEM_HORAS_MINIMAS = 4
SECAGEM_POTENCIAL_MINIMO_MM = 0.5
SECAGEM_VANTAGEM_DIA_DISTANTE = 1.10  # um dia mais distante só ganha se for 10% melhor


def periodo_secagem_por_dia(resposta_open_meteo):
    """Para cada dia: melhor período contínuo de horas secas e o seu potencial (mm)."""
    previsao_horaria = resposta_open_meteo.get("hourly") or {}
    instantes = previsao_horaria.get("time") or []

    def valor_horario(variavel, posicao):
        valores = previsao_horaria.get(variavel) or []
        return valores[posicao] if posicao < len(valores) else None

    inicio_hora_atual = datetime.datetime.now().replace(minute=0, second=0, microsecond=0)
    melhor_por_data, periodo_atual_por_data = {}, {}
    for posicao, instante in enumerate(instantes):
        data_iso, hora = instante[:10], int(instante[11:13])
        hora_ja_passou = datetime.datetime.fromisoformat(instante) < inicio_hora_atual
        chuva_mm = valor_horario("precipitation", posicao) or 0
        prob_chuva = valor_horario("precipitation_probability", posicao) or 0
        humidade = valor_horario("relative_humidity_2m", posicao)
        hora_seca = (valor_horario("is_day", posicao) == 1 and not hora_ja_passou
                     and chuva_mm < SECAGEM_CHUVA_MAXIMA_MM
                     and prob_chuva <= SECAGEM_PROB_CHUVA_MAXIMA
                     and humidade is not None and humidade < SECAGEM_HUMIDADE_MAXIMA)
        if not hora_seca:
            periodo_atual_por_data[data_iso] = None
            continue
        periodo = periodo_atual_por_data.get(data_iso)
        if periodo is None:
            periodo = {"hora_inicio": hora, "hora_fim": hora, "horas": 0, "potencial_mm": 0.0}
            periodo_atual_por_data[data_iso] = periodo
        periodo["horas"] += 1
        periodo["hora_fim"] = hora + 1
        periodo["potencial_mm"] += valor_horario("et0_fao_evapotranspiration", posicao) or 0
        melhor = melhor_por_data.get(data_iso)
        if melhor is None or periodo["potencial_mm"] > melhor["potencial_mm"]:
            melhor_por_data[data_iso] = dict(periodo)
    for periodo in melhor_por_data.values():
        periodo["potencial_mm"] = round(periodo["potencial_mm"], 2)
        periodo["dia_bom"] = (periodo["horas"] >= SECAGEM_HORAS_MINIMAS
                              and periodo["potencial_mm"] >= SECAGEM_POTENCIAL_MINIMO_MM)
    return melhor_por_data


def indice_melhor_dia_secagem(dias):
    """Índice do melhor dia para secar roupa (ou None se nenhum for bom)."""
    indice_melhor = None
    for indice_dia, dia in enumerate(dias):
        periodo = dia.get("secagem")
        if not periodo or not periodo.get("dia_bom"):
            continue
        if indice_melhor is None:
            indice_melhor = indice_dia
            continue
        potencial_atual = dias[indice_melhor]["secagem"]["potencial_mm"]
        if periodo["potencial_mm"] > potencial_atual * SECAGEM_VANTAGEM_DIA_DISTANTE:
            indice_melhor = indice_dia
    return indice_melhor


def interpretar_open_meteo(resposta_open_meteo):
    blocos_por_data = blocos_4h_por_dia(resposta_open_meteo)
    secagem_por_data = periodo_secagem_por_dia(resposta_open_meteo)
    previsao_diaria = resposta_open_meteo["daily"]
    datas = previsao_diaria["time"]

    def valor_diario(variavel, posicao):
        valores = previsao_diaria.get(variavel) or []
        return valores[posicao] if posicao < len(valores) else None

    dias_previstos = []
    for posicao, data_iso in enumerate(datas):
        descricao, icone = CODIGOS_WMO.get(valor_diario("weather_code", posicao), ("—", "nublado"))
        direcao_graus = valor_diario("wind_direction_10m_dominant", posicao)
        dias_previstos.append({
            "data_iso": data_iso[:10],
            "nome_dia": nome_do_dia(data_iso),
            "descricao": descricao,
            "icone": icone,
            "temp_min": valor_diario("temperature_2m_min", posicao),
            "temp_max": valor_diario("temperature_2m_max", posicao),
            "prob_chuva": valor_diario("precipitation_probability_max", posicao),
            "vento_nos": valor_diario("wind_speed_10m_max", posicao),
            "rajada_nos": valor_diario("wind_gusts_10m_max", posicao),
            "direcao_graus": direcao_graus,
            "direcao": rumo_do_vento(direcao_graus),
            "blocos_4h": blocos_por_data.get(data_iso[:10], []),
            "secagem": secagem_por_data.get(data_iso[:10]),
        })
    return dias_previstos


def obter_open_meteo(config):
    parametros = {
        "latitude": config["latitude"],
        "longitude": config["longitude"],
        "daily": ",".join([
            "weather_code", "temperature_2m_max", "temperature_2m_min",
            "precipitation_probability_max", "wind_speed_10m_max",
            "wind_gusts_10m_max", "wind_direction_10m_dominant",
        ]),
        "hourly": ",".join([
            "weather_code", "temperature_2m", "precipitation_probability", "precipitation",
            "wind_speed_10m", "wind_gusts_10m", "is_day",
            "et0_fao_evapotranspiration", "relative_humidity_2m",
        ]),
        "timezone": "Europe/Lisbon",
        "forecast_days": 5,
        "wind_speed_unit": "kn",
        "models": config["modelo_vento"],
    }
    url = "https://api.open-meteo.com/v1/forecast?" + urllib.parse.urlencode(parametros)
    return interpretar_open_meteo(pedir_json(url))

# ---------------------------------------------------------------- AccuWeather

URL_ACCUWEATHER = "https://dataservice.accuweather.com"


def pedir_accuweather(caminho, parametros, chave_api):
    """Tenta a chave como parâmetro; se der 401, tenta como 'Bearer' (contas novas)."""
    try:
        parametros_com_chave = dict(parametros, apikey=chave_api)
        return pedir_json(f"{URL_ACCUWEATHER}{caminho}?{urllib.parse.urlencode(parametros_com_chave)}")
    except urllib.error.HTTPError as erro_http:
        if erro_http.code != 401:
            raise
        return pedir_json(f"{URL_ACCUWEATHER}{caminho}?{urllib.parse.urlencode(parametros)}",
                          {"Authorization": f"Bearer {chave_api}"})


def interpretar_accuweather(resposta_accuweather):
    dias_previstos = []
    for previsao_do_dia in resposta_accuweather["DailyForecasts"]:
        periodo_diurno = previsao_do_dia.get("Day", {})
        dias_previstos.append({
            "data_iso": previsao_do_dia["Date"][:10],
            "nome_dia": nome_do_dia(previsao_do_dia["Date"]),
            "descricao": periodo_diurno.get("IconPhrase", "—"),
            "icone": icone_accuweather(periodo_diurno.get("Icon")),
            "temp_min": previsao_do_dia["Temperature"]["Minimum"]["Value"],
            "temp_max": previsao_do_dia["Temperature"]["Maximum"]["Value"],
            "prob_chuva": periodo_diurno.get("PrecipitationProbability"),
        })
    return dias_previstos


def obter_accuweather(config):
    chave_api = (config.get("accuweather_api_key") or "").strip()
    if not chave_api:
        raise ValueError("falta a chave AccuWeather no config.json")
    if not config.get("accuweather_location_key"):
        localidade = pedir_accuweather(
            "/locations/v1/cities/geoposition/search",
            {"q": f"{config['latitude']},{config['longitude']}", "language": "pt-pt"}, chave_api)
        config["accuweather_location_key"] = localidade["Key"]
        gravar_json(CAMINHO_CONFIG, config)
    resposta = pedir_accuweather(f"/forecasts/v1/daily/5day/{config['accuweather_location_key']}",
                                 {"language": "pt-pt", "metric": "true", "details": "true"},
                                 chave_api)
    return interpretar_accuweather(resposta)

# ---------------------------------------------------------------- observação real (METAR)

def interpretar_metar(resposta_metar):
    """Última observação METAR do aeroporto (JSON da aviationweather.gov)."""
    if not resposta_metar:
        raise ValueError("sem observação recente")
    ultima_observacao = resposta_metar[0]
    direcao_vento = ultima_observacao.get("wdir")
    if direcao_vento == "VRB":
        direcao_texto = "variável"
    else:
        direcao_texto = rumo_do_vento(direcao_vento if isinstance(direcao_vento, (int, float))
                                      else None)
    return {
        "temperatura": ultima_observacao.get("temp"),
        "vento_nos": ultima_observacao.get("wspd"),
        "rajada_nos": ultima_observacao.get("wgst"),
        "direcao": direcao_texto,
        "medido_em": ultima_observacao.get("obsTime"),  # segundos desde 1970 (UTC)
    }


def obter_metar(config):
    parametros = urllib.parse.urlencode({"ids": config["estacao_metar"], "format": "json"})
    return interpretar_metar(pedir_json(f"https://aviationweather.gov/api/data/metar?{parametros}"))


def juntar_fontes(dias_accuweather, dias_open_meteo):
    """Uma linha por dia: tempo/temperaturas do AccuWeather (se houver) e vento/detalhe
    da Open-Meteo."""
    open_meteo_por_data = {dia.get("data_iso"): dia for dia in dias_open_meteo}
    dias_base = dias_accuweather or dias_open_meteo
    dias_juntos = []
    for dia_base in dias_base:
        dia_open_meteo = open_meteo_por_data.get(dia_base.get("data_iso"), {})
        dias_juntos.append({
            "nome_dia": dia_base.get("nome_dia", "—"),
            "descricao": dia_base.get("descricao", "—"),
            "icone": dia_base.get("icone", "nublado"),
            "temp_min": dia_base.get("temp_min"),
            "temp_max": dia_base.get("temp_max"),
            "prob_chuva": dia_base.get("prob_chuva"),
            "vento_nos": dia_open_meteo.get("vento_nos"),
            "rajada_nos": dia_open_meteo.get("rajada_nos"),
            "direcao": dia_open_meteo.get("direcao", "—"),
            "blocos_4h": dia_open_meteo.get("blocos_4h") or [],
            "secagem": dia_open_meteo.get("secagem"),
        })
    return dias_juntos

